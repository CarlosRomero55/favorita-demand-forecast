# Motor de base de datos: duckdb (por defecto, archivo local) o mssql (SQL Server local)
DB_ENGINE=duckdb
DUCKDB_PATH=data/processed/favorita.duckdb

# Solo si DB_ENGINE=mssql (autenticación de Windows, sin contraseñas)
MSSQL_SERVER=localhost
MSSQL_DATABASE=FavoritaForecast
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# Opcional: limitar el entrenamiento si la memoria no alcanza (fecha AAAA-MM-DD)
TRAIN_START=2015-01-01
